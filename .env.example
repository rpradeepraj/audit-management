# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL: Project URL from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous API key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Privileged secret service-role key (server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
